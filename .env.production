# Production Environment Configuration for Student Management System
# IMPORTANT: Update all default values before deploying to production!

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
DB_NAME=sms_production
DB_USER=sms_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# JWT Configuration - CRITICAL: Change these in production!
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_JWT_KEY_IN_PRODUCTION_USE_64_CHARS_MIN
JWT_EXPIRE=7d

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION

# Frontend URL
CLIENT_URL=https://your-domain.com

# File Upload Service (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security Settings
ENCRYPTION_KEY=CHANGE_THIS_32_CHARACTER_KEY_FOR_PRODUCTION
BCRYPT_ROUNDS=12

# Rate Limiting (Stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring and Logging
LOG_LEVEL=warn
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/app.log

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Session Configuration
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_IN_PRODUCTION
SESSION_EXPIRE=86400000

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Performance Settings
ENABLE_COMPRESSION=true
ENABLE_CACHE=true
CACHE_TTL=3600

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
CORS_ORIGIN=https://your-domain.com

# Database Backup
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
SMS_PROVIDER_API_KEY=your_sms_provider_key

# Third-party Integrations
GOOGLE_MAPS_API_KEY=your_google_maps_key
ANALYTICS_TRACKING_ID=your_analytics_id

# Emergency Contact
ADMIN_EMAIL=admin@your-domain.com
SUPPORT_EMAIL=support@your-domain.com